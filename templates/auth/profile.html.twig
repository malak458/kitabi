{% extends 'base.html.twig' %}

{% block title %}{{ user.prenom }} {{ user.nom }} — Kitabi{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/profile.css') }}">
{% endblock %}

{% block body %}

    <div class="profile-page">

        {# ── Bandeau hero ── #}
        <div class="profile-hero">
            <div class="hero-bg"></div>
            <div class="hero-content">

                <div class="hero-avatar-wrap">
                    {% if user.image %}
                        <img src="{{ asset('uploads/profiles/' ~ user.image) }}"
                             class="hero-avatar" alt="{{ user.prenom }}">
                    {% else %}
                        <img src="https://ui-avatars.com/api/?name={{ user.prenom }}+{{ user.nom }}&background=c8860a&color=fff&size=240&bold=true"
                             class="hero-avatar" alt="{{ user.prenom }}">
                    {% endif %}
                </div>

                <div class="hero-info">
                    <h1 class="hero-name">
                        {{ user.prenom }} <span>{{ user.nom }}</span>
                    </h1>
                    <a href="{{ path('app_profile_edit') }}" class="btn-edit">
                        <span class="material-icons">edit</span> Modifier le profil
                    </a>
                </div>

            </div>
        </div>

        {# ── Carte bio ── #}
        <div class="profile-body">
            <section class="bio-card">
                <div class="bio-card__header">
                    <span class="material-icons">auto_stories</span>
                    <h2>Bio</h2>
                </div>
                <p class="bio-card__text">
                    {{ user.bio ?: 'Aucune bio disponible pour le moment.' }}
                </p>
            </section>
        </div>

    </div>

{% endblock %}
