{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/profile.css') }}">
{% endblock %}

{% block body %}

    <div class="profile-wrapper">

        <div class="profile-card">

            <div class="profile-header">

                {% if user.image %}
                    <img src="{{ asset('uploads/profiles/' ~ user.image) }}"
                         class="profile-avatar">
                {% else %}
                    <img src="https://ui-avatars.com/api/?name={{ user.nom }}+{{ user.prenom }}&background=c8860a&color=fff"
                         class="profile-avatar">
                {% endif %}

                <h2>{{ user.prenom }} {{ user.nom }}</h2>
                <p class="muted">{{ user.email }}</p>

                <a href="{{ path('app_profile_edit') }}" class="btn-primary">
                    Edit Profile
                </a>

            </div>

            <hr>

            <div class="bio-section">
                <h4>Bio</h4>
                <p>{{ user.bio ?: 'Aucune bio disponible' }}</p>
            </div>

        </div>

    </div>

{% endblock %}
