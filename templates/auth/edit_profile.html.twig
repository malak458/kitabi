{% extends 'base.html.twig' %}

{% block title %}Edit Profile{% endblock %}

{% block body %}

    <div class="container mt-5">

        <div class="card p-4">

            <h2>Edit Profile</h2>

            {{ form_start(form) }}

            {{ form_row(form.nom) }}
            {{ form_row(form.prenom) }}
            {{ form_row(form.bio) }}

            <button class="btn btn-success mt-3">
                Save
            </button>

            {{ form_end(form) }}

        </div>

    </div>

{% endblock %}
