	//script pour fenetre s ouvrant en demandant l echange 

<div class="modal fade" id="exchangeModal" tabindex="-1" aria-labelledby="exchangeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: var(--white); border: 1px solid var(--border);">
            
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="exchangeModalLabel" style="color: var(--ink);">Proposer un échange</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="exchangeForm" action="" method="POST">
                <div class="modal-body">
                    
                    <!-- Menu déroulant pour choisir le mode -->
                    <select id="bookModeSelect" name="book_mode" class="form-select mb-3" style="display: none;">
                        <option value="existing">existing</option>
                        <option value="new">new</option>
                    </select>

                    <!-- Bloc Livre existant -->
                    <div id="existingBookBlock">
                        <p style="color: var(--muted);">Lequel de vos livres souhaitez-vous donner en contrepartie ?</p>
                        <div class="mb-3">
                            <select name="offered_book_id" id="offeredBookSelect" class="form-select" required style="border-color: var(--border);">
                                <option value="">-- Choisir un livre dans votre bibliothèque --</option>
                                {% for myBook in myBooks %}
                                    <option value="{{ myBook.id }}">{{ myBook.titre }} - {{ myBook.auteur }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="text-end">
                            <button type="button" id="btnShowNewBook" class="btn btn-link btn-sm p-0" style="text-decoration: none; color: #008080;">
                                + Le livre n'est pas dans ma liste
                            </button>
                        </div>
                    </div>

                    <!-- Bloc Nouveau livre (caché par défaut) -->
                    <div id="newBookBlock" style="display: none;">
                        <p style="color: var(--muted);">Enregistrez le livre que vous offrez :</p>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold" style="color: var(--ink);">Titre du livre *</label>
                            <input type="text" name="new_book_title" id="newBookTitle" class="form-control" placeholder="Ex: Le Petit Prince" style="border-color: var(--border);">
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold" style="color: var(--ink);">Auteur</label>
                            <input type="text" name="new_book_author" id="newBookAuthor" class="form-control" placeholder="Ex: Antoine de Saint-Exupéry" style="border-color: var(--border);">
                        </div>

                        <div class="text-end">
                            <button type="button" id="btnShowExistingBook" class="btn btn-link btn-sm p-0" style="text-decoration: none; color: #6c757d;">
                                ← Retourner à ma liste
                            </button>
                        </div>
                    </div>

                </div>
                
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn" style="background-color: #008080; color: white;">Valider le troc</button>
                </div>
            </form>

        </div>
    </div>
</div>
<script>
    // Attendre que le DOM soit complètement chargé
    document.addEventListener('DOMContentLoaded', function() {
        
        // Éléments du modal
        const existingBookBlock = document.getElementById('existingBookBlock');
        const newBookBlock = document.getElementById('newBookBlock');
        const btnShowNewBook = document.getElementById('btnShowNewBook');
        const btnShowExistingBook = document.getElementById('btnShowExistingBook');
        const offeredBookSelect = document.getElementById('offeredBookSelect');
        const newBookTitle = document.getElementById('newBookTitle');
        const newBookAuthor = document.getElementById('newBookAuthor');
        const bookModeSelect = document.getElementById('bookModeSelect');
        const exchangeForm = document.getElementById('exchangeForm');
        
        // Fonction pour réinitialiser le formulaire
        function resetForm() {
            if (existingBookBlock) existingBookBlock.style.display = 'block';
            if (newBookBlock) newBookBlock.style.display = 'none';
            if (bookModeSelect) bookModeSelect.value = 'existing';
            if (offeredBookSelect) {
                offeredBookSelect.value = '';
                offeredBookSelect.required = true;
            }
            if (newBookTitle) {
                newBookTitle.value = '';
                newBookTitle.required = false;
            }
            if (newBookAuthor) newBookAuthor.value = '';
        }
        
        // Bouton "Le livre n'est pas dans ma liste"
        if (btnShowNewBook) {
            btnShowNewBook.addEventListener('click', function(e) {
                e.preventDefault();
                if (existingBookBlock) existingBookBlock.style.display = 'none';
                if (newBookBlock) newBookBlock.style.display = 'block';
                if (bookModeSelect) bookModeSelect.value = 'new';
                if (offeredBookSelect) offeredBookSelect.required = false;
                if (newBookTitle) newBookTitle.required = true;
            });
        }
        
        // Bouton "Retourner à ma liste"
        if (btnShowExistingBook) {
            btnShowExistingBook.addEventListener('click', function(e) {
                e.preventDefault();
                if (existingBookBlock) existingBookBlock.style.display = 'block';
                if (newBookBlock) newBookBlock.style.display = 'none';
                if (bookModeSelect) bookModeSelect.value = 'existing';
                if (offeredBookSelect) offeredBookSelect.required = true;
                if (newBookTitle) newBookTitle.required = false;
            });
        }
        
        // Quand le modal s'ouvre
        const exchangeModal = document.getElementById('exchangeModal');
        if (exchangeModal) {
            exchangeModal.addEventListener('show.bs.modal', function(event) {
                const button = event.relatedTarget;
                const bookId = button.getAttribute('data-book-id');
                if (exchangeForm) {
                    exchangeForm.action = '/exchange/create/' + bookId;
                }
                resetForm();
            });
        }
        
        // Validation avant soumission
        if (exchangeForm) {
            exchangeForm.addEventListener('submit', function(e) {
                const mode = bookModeSelect ? bookModeSelect.value : 'existing';
                
                if (mode === 'existing') {
                    if (!offeredBookSelect.value) {
                        e.preventDefault();
                        alert('Veuillez sélectionner un livre à échanger');
                        return false;
                    }
                } else {
                    if (!newBookTitle.value.trim()) {
                        e.preventDefault();
                        alert('Veuillez saisir le titre du livre que vous offrez');
                        return false;
                    }
                }
                return true;
            });
        }
        
    });
</script>
{% endblock %}
