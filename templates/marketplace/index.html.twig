<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KITAB — Marketplace</title>
    <base href="/">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Sans:wght@300;400;500;600&family=Amiri:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="icon" href="{{ asset('favicon (1).ico') }}" type="image/x-icon" />

    <link rel="stylesheet" href="{{ asset('assets/css/marketPlace.css') }}" />
  </head>
  <body>

    <nav id="mainNav">
      <a href="#" class="logo">KITAB<span class="text_arb">كتاب</span></a>
      <ul class="nav-links">
        <li><a href="#" id="nav_marketplace" class="active"><span class="material-icons">local_mall</span> Marketplace</a></li>
        <li><a href="#" id="nav_messages"><span class="material-icons">chat_bubble</span> Messages</a></li>
        <li><a href="#" id="nav_exchanges"><span class="material-icons">swap_horiz</span> Exchanges</a></li>
        <li><a href="#" id="nav_favorites"><span class="material-icons">favorite</span> Favorites</a></li>
        <li><a href="#" id="nav_reading_rooms"><span class="material-icons">import_contacts</span> Reading Rooms</a></li>
      </ul>

      <div class="nav-right">
        <a href="#" id="nav_profile"><span class="material-icons">account_circle</span> Profile</a>
        <a href="#" id="nav_logout"><span class="material-icons">logout</span>Log out</a>
        <div class="lang-switcher-nav">
          <button class="lang-btn" id="btn-en">EN</button>
          <button class="lang-btn" id="btn-fr">FR</button>
          <button class="lang-btn" id="btn-ar">AR</button>
        </div>
      </div>
    </nav>

    <div class="page-wrapper">
      
      <section class="hero-slider" id="heroSlider">
        <div class="slide s1 active" id="slide-0">
          <div class="slide-bg" style="background-image: url('https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=1800&q=80');"></div>
          <div class="slide-overlay"></div>
          <div class="slide-content">
            <div class="slide-eyebrow"><span class="dot"></span> Nouvelle collection — Printemps 2026</div>
            <h1 class="slide-title">Les livres trouvent<br /><em>leur lecteur</em></h1>
            <p class="slide-sub">Des milliers de livres d'occasion, rares et neufs. Achetez, vendez ou échangez avec des passionnés comme vous.</p>
          </div>
        </div>
      </section>

      <div class="content">
        <div class="bloc1">
          <div class="search-right">
            <input class="nav-search" type="text" placeholder="Rechercher un livre…" />
            <a href="{{ path('app_book_new') }}" class="nav-btn" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center;">Publier un livre</a>
            <button id="exchangeBtn" class="nav-btn">Exchange</button>
          </div>
        </div>

        <div class="cards-container">
          {% if books is defined and books is not empty %}
            {% for book in books %}
              <div class="book-card">
                <div class="image-container">
                  {# Affichage strict de l'image depuis ton dossier uploads #}
                  {# Affichage corrigé pointant vers assets/uploads #}
{# Affichage forcé de ton image spécifique #}
<img src="{{ asset('assets/uploads/image.webp') }}" alt="{{ book.titre }}" />
                  
                  {# Bloc badges alignés à gauche : Condition style rectangle arrondi en Vert Royal #}
                  <div class="left-badges">
                    {% if book.condition is defined and book.condition is not empty %}
                      <div class="conditionbook" style="background-color: #004B23; color: white; border-radius: 20px; padding: 5px 14px; font-size: 13px; font-weight: 500; border: 1px solid rgba(255,255,255,0.2); text-transform: capitalize; box-shadow: 0 4px 10px rgba(0,0,0,0.15);">
                        {{ book.condition }}
                      </div>
                    {% else %}
                      <div class="conditionbook" style="background-color: #004B23; color: white; border-radius: 20px; padding: 5px 14px; font-size: 13px; font-weight: 500; border: 1px solid rgba(255,255,255,0.2); box-shadow: 0 4px 10px rgba(0,0,0,0.15);">
                        Good
                      </div>
                    {% endif %}
                    
                    <button class="heart-btn" data-url="{{ path('app_book_favorite', { id: book.id }) }}" data-page-favoris="false">
                      {{ app.user and book.isFavoritedBy(app.user) ? '♥' : '♡' }}
                    </button>
                  </div>
                  
                  {% if book.forExchange %}
                    <div class="forexchange">for exchange</div>
                  {% endif %}
                </div>
                
                <div class="card-body">
                  <h4 class="nombook">{{ book.titre }}</h4>
                  <p>by {{ book.auteur }}</p>
                  <h6 class="booktype">{{ book.genre }}</h6>
                  
                  <span class="price" style="margin-left: 50px; margin-right: 0; color: green">
                    {{ book.prix }} dt
                  </span>
                  <br />
                  
                  <img src="{{ asset('assets/img/default-user.png') }}" alt="Owner" class="ownerpic" onerror="this.onerror=null; this.src='https://t3.ftcdn.net/jpg/02/99/04/20/360_F_299042079_vGBD7wIlSeNl7vOevWHiL93G4koMM967.jpg';" />
                  <span class="person">
                    {{ book.user ? (book.user.prenom ~ ' ' ~ book.user.nom) : 'Anonyme' }}
                  </span><br />
                  
                  <div class="card-actions">
                    <a href="{{ path('app_book_details', {'id': book.id}) }}" class="details"><i class="bi bi-book"></i> Details</a>
                    <a href="#" class="chat"><i class="bi bi-chat-left"></i> Chat</a>
                  </div>
                </div>
              </div>
            {% endfor %}
          {% else %}
            <div class="empty-marketplace-state">
              <h3>Bibliothèque temporairement vide</h3>
            </div>
          {% endif %}

          {{ include('includes/components/_ajouter_livre.html.twig', ignore_missing = true) }}
        </div>
      </div>

      {{ include('includes/components/_footer.html.twig', ignore_missing = true) }}
    </div>

    <script src="{{ asset('assets/js/marketPlace.js') }}"></script>
  </body>
</html>