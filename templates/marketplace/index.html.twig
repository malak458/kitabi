{% extends 'base.html.twig' %}

{% block title %}KITAB — Marketplace{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('assets/css/marketPlace.css') }}">
{% endblock %}
{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('assets/js/faireEchange.js') }}"></script>
	<script src="{{ asset('assets/js/marketPlace.js') }}"></script>
	<script src="{{ asset('assets/js/favorites-toggle.js') }}"></script>
{% endblock %}

{% block body %}
	<div
		class="page-wrapper">

		{# ===== HERO SLIDER ===== #}
		<section class="hero-slider" id="heroSlider">
			<div class="slide s1 active" id="slide-0">
				<div class="slide-bg" style="background-image: url('https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=1800&q=80');"></div>
				<div class="slide-overlay"></div>
				<div class="slide-content">
					<div class="slide-eyebrow">
						<span class="dot"></span>
						Nouvelle collection — Printemps 2026</div>
					<h1 class="slide-title">Les livres trouvent<br/><em>leur lecteur</em>
					</h1>
					<p class="slide-sub">Des milliers de livres d'occasion, rares et neufs.</p>
				</div>
			</div>
			<div class="slide s2" id="slide-1">
				<div class="slide-bg" style="background-image: url('https://media.istockphoto.com/id/1390798814/photo/reading-together-keeps-their-spirits-high.jpg?s=2048x2048&w=is&k=20&c=K2OmYPjL9FJ7vfLaILbLRmINjizA8hMrB5Sefp3Xl7Y=');"></div>
				<div class="slide-overlay"></div>
				<div class="slide-content">
					<div class="slide-eyebrow">
						<span class="dot"></span>
						Partagez votre passion !</div>
					<h1 class="slide-title">Lire ensemble,<br/><em>rêver plus loin</em>
					</h1>
					<p class="slide-sub">Plongez dans notre espace où chaque livre raconte une histoire.</p>
				</div>
			</div>
			<div class="slide s3" id="slide-2">
				<div class="slide-bg" style="background-image: url('https://media.istockphoto.com/id/1307288448/photo/high-school-or-college-student-returing-library.jpg?s=2048x2048&w=is&k=20&c=y2GsziTHL6yGHSjd4xM_hm8NFVw7WHXDlCbBuF8V24E=');"></div>
				<div class="slide-overlay"></div>
				<div class="slide-content">
					<div class="slide-eyebrow">
						<span class="dot"></span>
						Programme d'échange</div>
					<h1 class="slide-title">Donnez une<br/><em>seconde vie</em><br/>à vos livres</h1>
					<p class="slide-sub">Proposez vos livres à l'échange. Réduisez le coût de lecture.</p>
				</div>
			</div>
			<div class="slider-dots">
				<button class="dot-btn active" onclick="goTo(0)"></button>
				<button class="dot-btn" onclick="goTo(1)"></button>
				<button class="dot-btn" onclick="goTo(2)"></button>
			</div>
			<div class="slider-arrows">
				<button class="arrow-btn" onclick="prev()">&#8592;</button>
				<button class="arrow-btn" onclick="next()">&#8594;</button>
			</div>
			<div class="slide-counter" id="slideCounter">01 / 03</div>
		</section>

		{# ===== PROMO BAND ===== #}
		<div class="promo-band">
			<div
				class="promo-items">
				{# ... same as original ... #}
				<div class="promo-item">Livraison partout en Tunisie</div>
				<div class="promo-item">+ 12 000 livres disponibles</div>
				<div class="promo-item">Messagerie instantanée</div>
				<div class="promo-item">Échanges vérifiés &amp; sécurisés</div>
				<div class="promo-item">Paiement 100% sécurisé</div>
				{# Duplicate for seamless loop #}
				<div class="promo-item">Livraison partout en Tunisie</div>
				<div class="promo-item">+ 12 000 livres disponibles</div>
				<div class="promo-item">Messagerie instantanée</div>
				<div class="promo-item">Échanges vérifiés &amp; sécurisés</div>
				<div class="promo-item">Paiement 100% sécurisé</div>
			</div>
		</div>

		<div
			class="content">

			{# ===== FILTRES — soumis via GET (rechargement page) ===== #}
			<form method="GET" action="{{ path('app_marketplace') }}" id="filterForm">
				<div class="bloc1">
					<div class="search-right">
						<div style="position:relative; display:inline-block;">
							<input class="nav-search" type="text" id="searchInput" name="search" placeholder="Rechercher un livre…" value="{{ filters.search }}" autocomplete="off"/>
							<ul id="searchSuggestions" style="
																																																																																																																																																																																																																																																								        display:none;
																																																																																																																																																																																																																																																								        position:absolute;
																																																																																																																																																																																																																																																								        top:100%;
																																																																																																																																																																																																																																																								        left:0;
																																																																																																																																																																																																																																																								        background:#fff;
																																																																																																																																																																																																																																																								        border-radius:12px;
																																																																																																																																																																																																																																																								        box-shadow:0 8px 24px rgba(0,0,0,0.15);
																																																																																																																																																																																																																																																								        list-style:none;
																																																																																																																																																																																																																																																								        z-index:999;
																																																																																																																																																																																																																																																								        margin-top:6px;
																																																																																																																																																																																																																																																								        padding:6px 0;
																																																																																																																																																																																																																																																								        min-width:350px;
																																																																																																																																																																																																																																																								    "></ul>
						</div>
						<a href="{{ path('app_book_new') }}" class="nav-btn" style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center;">
							Publier un livre
						</a>
					</div>

					<div class="blocfiltration">
						<span style="margin-left:10px; font-size:17px">Filtrer :</span>

						{# TRI #}
						<select name="sort" class="selectbar" onchange="this.form.submit()">
							{% for value, label in sortOptions %}
								<option value="{{ value }}" {% if filters.sort == value %} selected {% endif %}>
									{{ label }}
								</option>
							{% endfor %}
						</select>

						{# GENRE #}
						<select name="genre" class="selectbar" onchange="this.form.submit()">
							<option value="" {% if filters.genre == '' %} selected {% endif %}>All Genres</option>
							{% for g in genres %}
								<option value="{{ g }}" {% if filters.genre == g %} selected {% endif %}>{{ g }}</option>
							{% endfor %}
						</select>

						{# CONDITION #}
						<select name="condition" class="selectbar" onchange="this.form.submit()">
							<option value="" {% if filters.condition == '' %} selected {% endif %}>All conditions</option>
							{% for c in conditions %}
								<option value="{{ c }}" {% if filters.condition == c %} selected {% endif %}>{{ c }}</option>
							{% endfor %}
						</select>
					</div>
				</div>
			</form>

			<br>
			<p id="bookCount">showing
				<span id="countNum">{{ bookCount }}</span>
				books</p>

			{# ===== IMAGE 404 si aucun résultat ===== #}
			{% if noResult %}
				<div style="display:flex; flex-direction:column; align-items:center; justify-content:center; width:100%; padding:3rem 0;">
					<img src="{{ asset('images/notfound.png') }}" alt="Aucun résultat" style="max-width:380px; width:90%; opacity:0.9;"/>
				</div>
			{% endif %}

			{# ===== CARTES LIVRES ===== #}
			<div class="cards-container">
				{% for book in books %}
					{% set condClass = book.condition|lower|replace({' ': '-'}) %}
					<div class="book-card">
						<div class="image-container">
							<img src="{{ book.image starts with 'http' ? book.image : asset('uploads/books/' ~ book.image) }}" alt="{{ book.titre }}"/>

							<div class="left-badges">

								<div class="conditionbook {{ condClass }}">
									{{ book.condition }}
								</div>

								{% set isFavorite = false %}
{% if app.user %}
    {% for fav in app.user.favorites ?? [] %}
        {% if fav.book.id == book.id %}
            {% set isFavorite = true %}
        {% endif %}
    {% endfor %}
{% endif %}

<button class="heart-btn"
    {% if app.user %}
        data-url="{{ path('app_book_favorite', {id: book.id}) }}"
    {% else %}
        data-login="{{ path('app_login') }}"
    {% endif %}
    style="color: {{ isFavorite ? 'red' : 'gray' }};">
    {{ isFavorite ? '♥' : '♡' }}
</button>

							</div>
							<br>
							{% if book.forExchange %}
								<div class="forexchange">for exchange</div>
							{% endif %}

						</div>
						<div class="card-body">
							<h4 class="nombook">{{ book.titre }}</h4>
							<p>by
								{{ book.auteur }}</p>
							<h6 class="booktype">{{ book.genre }}</h6>
							<span class="price" style="margin-left:50px; color:green;">
								{{ book.prix }}dt
							</span>
							<br/>
							{% if book.user %}
								<img src="{{ book.user.photo ? asset('uploads/avatars/' ~ book.user.photo) : 'https://ui-avatars.com/api/?name=' ~ book.user.prenom }}" alt="{{ book.user.prenom }}" class="ownerpic"/>
								<span class="person">{{ book.user.prenom }}
									{{ book.user.nom }}</span>
							{% endif %}
							<br/>
							<a href="{{ path('app_book_show', {id: book.id}) }}" class="details">
								<i class="bi bi-book"></i>
								Details
							</a>
							{% if book.forExchange %}
							    {% if app.user %}
                                    <button type="button" 
                    onclick="var modal = new bootstrap.Modal(document.getElementById('exchangeModal')); document.getElementById('exchangeForm').action = '/exchange/create/{{ book.id }}'; modal.show();"
                    style="border: none; background: linear-gradient(135deg, #ffc107, #ff9800); color: white; padding: 8px 60px; border-radius: 20px; cursor: pointer; margin-left: 10px; font-size: 14px;">
                <i class="bi bi-arrow-left-right"></i>
                Faire un échange
            </button>
        {% else %}
            <a href="{{ path('app_login') }}" 
               style="display: inline-block; background: linear-gradient(135deg, #ffc107, #ff9800); color: #000; padding: 8px 60px; border-radius: 20px; text-decoration: none; margin-left: 10px; font-size: 14px;">
                <i class="bi bi-box-arrow-in-right"></i>
                Faire un échange
                                    </a>
                            {% endif %}
							{% else %}
							    <a href="#" class="chat">
									<i class="bi bi-chat-dots"></i>
									Chat
								</a>
							{% endif %}
							
						</div>
					</div>
				{% endfor %}
			</div>

		</div>


	</div>
	{% include 'marketplace/banner.html.twig' %}
	<div class="space-before-footer"></div>
	<div class="space-before-footer"></div>
	{# ===== BLOC AVIS LECTEURS ===== #}
	<section
		class="kb-reviews-section">

		{# En-tête #}
		<div class="kb-reviews-header">
			<div>
				<p class="kb-label">✦ Ce que disent nos lecteurs</p>
				<h2 class="kb-reviews-title">
					Ils ont essayé
					<span>KITAB</span>
					— voici leur avis
				</h2>
			</div>
			<div class="kb-avg-block">
				<div class="kb-avg-num">{{ averageRating ?: '—' }}</div>
				<div class="kb-avg-stars">
					{% if averageRating %}
						{% for i in 1..5 %}
							{{ i <= averageRating|round ? '★' : '☆' }}
						{% endfor %}
					{% endif %}
				</div>
				<div class="kb-avg-count">{{ reviewCount }}
					avis vérifiés</div>
			</div>
		</div>

		{# Flash messages #}
		{% for msg in app.flashes('success') %}
			<div class="kb-flash kb-flash--success">{{ msg }}</div>
		{% endfor %}
		{% for msg in app.flashes('error') %}
			<div class="kb-flash kb-flash--error">{{ msg }}</div>
		{% endfor %}

		{# Grille des avis #}
		{% if reviews is not empty %}
			<div class="kb-reviews-grid">
				{% for review in reviews %}
					<div class="kb-review-card">
						<div class="kb-review-stars">
							{% for i in 1..5 %}
								{{ i <= review.rating ? '★' : '☆' }}
							{% endfor %}
						</div>
						<p class="kb-review-text">{{ review.content }}</p>
						<div class="kb-review-user">
							<div class="kb-avatar">
								{{ review.user.prenom|first|upper }}{{ review.user.nom|first|upper }}
							</div>
							<div>
								<p class="kb-review-name">{{ review.user.prenom }}
									{{ review.user.nom|first }}.</p>
								<p class="kb-review-date">{{ review.createdAt|date('d/m/Y') }}</p>
							</div>
						</div>
					</div>
				{% endfor %}
			</div>
		{% else %}
			<p class="kb-no-review">Soyez le premier à laisser un avis !</p>
		{% endif %}

		{# === FORMULAIRE : seulement si connecté === #}
		<div class="kb-form-wrapper">
			{% if app.user %}
				<h3 class="kb-form-title">Laisser un avis</h3>
				<form
					action="{{ path('app_marketplace_review') }}" method="POST" class="kb-form">

					{# Étoiles interactives #}
					<div class="kb-star-picker" id="starPicker">
						{% for i in 1..5 %}
							<span class="kb-star" data-value="{{ i }}">☆</span>
						{% endfor %}
						<input type="hidden" name="rating" id="ratingInput" value="0" required>
					</div>

					<textarea name="content" class="kb-textarea" placeholder="Partagez votre expérience avec la communauté..." rows="3" maxlength="500" required></textarea>

					<button type="submit" class="kb-submit-btn">
						Publier mon avis
					</button>
				</form>

			{% else %}
				{# Utilisateur non connecté #}
				<div class="kb-login-prompt">
					<span class="kb-lock-icon">🔒</span>
					<p>Connecte-toi pour partager ton avis avec la communauté KITAB</p>
					<a href="{{ path('app_login') }}" class="kb-login-link">Se connecter</a>
					<a href="{{ path('app_register') }}" class="kb-register-link">Créer un compte</a>
				</div>
			{% endif %}
		</div>

	</section>

	{# Script étoiles interactif #}
	<script>
		(function () {
const stars = document.querySelectorAll('#starPicker .kb-star');
const input = document.getElementById('ratingInput');
let selected = 0;

stars.forEach(star => {
star.addEventListener('mouseenter', () => highlight(+ star.dataset.value));
star.addEventListener('mouseleave', () => highlight(selected));
star.addEventListener('click', () => {
selected = + star.dataset.value;
input.value = selected;
highlight(selected);
});
});

function highlight(val) {
stars.forEach(s => s.textContent = + s.dataset.value <= val ? '★' : '☆');
}
})();
	</script>
	<div class="space-before-footer"></div>
	<div class="space-before-footer"></div>

{% endblock %}

