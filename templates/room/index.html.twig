{% extends 'base.html.twig' %}

{% block title %}Reading Rooms - KITABI{% endblock %}

{% block stylesheets %}
<style>
  
    .page-wrapper { 
        min-height: calc(100vh - var(--nav-h)); 
    }

    
    .page-header {
        background: linear-gradient(105deg, rgba(26,18,8,.97) 0%, rgba(14,107,94,.9) 60%, rgba(200,134,10,.4) 100%);
        padding: 36px 5vw 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }
    .page-header-text { 
        position: relative; 
        z-index: 2; 
    }
    .page-header-text h1 {
        font-family: "Playfair Display", serif;
        font-size: 32px;
        font-weight: 900;
        color: #fff;
        margin: 0;
    }
    .page-header-text p { 
        color: rgba(255,253,248,.6); 
        font-size: 14px; 
        margin: 6px 0 0; 
    }

    
    .create-room-btn {
        position: relative;
        z-index: 2;
        background: var(--amber) !important;
        border: none !important;
        border-radius: 50px;
        padding: 12px 28px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: all .3s ease;
        color: #fff !important;
        display: inline-block;
        cursor: pointer;
    }
    .create-room-btn:hover {
        background: var(--rust) !important;
        transform: translateY(-2px);
        color: #fff !important;
        text-decoration: none;
    }

    
    .page-body { 
        padding: 28px 5vw; 
        background: var(--sand); 
    }

    
    .stats-container {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 28px;
    }
    .stat-card {
        background: var(--white);
        border-radius: 16px;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 4px 16px rgba(26,18,8,.07);
        border-bottom: 3px solid transparent;
    }
    .stat-card.live { border-bottom-color: #dc2626; }
    .stat-card.scheduled { border-bottom-color: var(--teal); }
    .stat-card.myrooms { border-bottom-color: var(--amber); }
    .stat-card.totalrooms { border-bottom-color: var(--rust); }
    
    .stat-info { flex: 1; }
    .stat-title { 
        font-size: 11px; 
        color: var(--muted); 
        margin-bottom: 6px; 
        font-weight: 600; 
        text-transform: uppercase; 
        letter-spacing: 1px; 
    }
    .stat-number { 
        font-family: "Playfair Display", serif; 
        font-size: 32px; 
        font-weight: 900; 
    }
    .stat-card.live .stat-number { color: #dc2626; }
    .stat-card.scheduled .stat-number { color: var(--teal); }
    .stat-card.myrooms .stat-number { color: var(--amber); }
    .stat-card.totalrooms .stat-number { color: var(--rust); }
    
    .stat-icon img {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: 10px;
    }

   
    .search-area {
        background: var(--ink);
        border-radius: 16px;
        padding: 18px 22px;
        margin-bottom: 22px;
    }
    .search-bar {
        width: 100%;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 50px;
        padding: 12px 20px;
        font-size: 14px;
        color: rgba(255,253,248,.85);
        outline: none;
    }
    .search-bar:focus {
        background: rgba(255,255,255,.15);
        border-color: var(--amber-mid);
    }
    .search-bar::placeholder {
        color: rgba(255,253,248,.4);
    }

    
    .nav-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }
    .nav-tab {
        background: var(--white);
        border: 1.5px solid var(--border);
        border-radius: 50px;
        padding: 10px 24px;
        text-decoration: none;
        color: var(--muted);
        font-weight: 600;
        font-size: 13px;
        transition: all .3s;
        cursor: pointer;
        display: inline-block;
    }
    .nav-tab:hover {
        border-color: var(--teal);
        color: var(--teal);
        background: var(--white);
        text-decoration: none;
    }
    .nav-tab.active {
        background: var(--teal) !important;
        border-color: var(--teal) !important;
        color: #fff !important;
    }

    hr.separator {
        border: none;
        border-top: 1px solid var(--border);
        margin: 8px 0 20px;
    }

  
    .section-label {
        font-size: 11px;
        font-weight: 700;
        color: var(--amber);
        letter-spacing: 2.5px;
        text-transform: uppercase;
        margin: 0 0 16px 0;
    }

    
    .rooms-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 22px;
    }
    
   
    .room-card {
        background: var(--white);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(26,18,8,.08);
        border: 1px solid var(--border);
        transition: all .3s ease;
    }
    .room-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 14px 32px rgba(26,18,8,.14);
        border-color: var(--amber-mid);
    }
    .room-image {
        position: relative;
        width: 100%;
        height: 240px;
        overflow: hidden;
        background: #f5f0e8;
    }
    .room-image img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        background: white;
    }
    .badge {
        position: absolute;
        top: 12px;
        left: 12px;
        padding: 5px 13px;
        color: white;
        border-radius: 50px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }
    .badge.live { background: #dc2626; }
    .badge.scheduled { background: var(--teal); }
    
    .participants {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(26,18,8,.7);
        color: var(--amber-light);
        padding: 5px 12px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
    }
    .room-content {
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .room-content h3 {
        font-family: "Playfair Display", serif;
        font-size: 18px;
        font-weight: 700;
        margin: 0;
        color: var(--ink);
    }
    .room-author {
        color: var(--muted);
        font-size: 13px;
        margin: 4px 0 0;
    }
    .progress-container {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }
    .progress-bar-bg {
        width: 100%;
        background: var(--border);
        height: 6px;
        border-radius: 10px;
        overflow: hidden;
    }
    .progress-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--teal), var(--amber));
        border-radius: 10px;
        width: 0%;
    }
    .progress-text {
        font-size: 11px;
        color: var(--muted);
    }
    .tags {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }
    .tag {
        background: var(--amber-light);
        border: 1px solid var(--border);
        padding: 4px 11px;
        border-radius: 50px;
        font-size: 11px;
        color: var(--rust);
        font-weight: 600;
    }
    
    
    .room-action-btn {
        width: 100%;
        padding: 13px 20px;
        border: none;
        border-radius: 50px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all .3s;
        font-family: "DM Sans", sans-serif;
    }
    .join-btn {
        background: var(--teal);
        color: white;
    }
    .join-btn:hover {
        background: var(--teal-dark);
        transform: translateY(-2px);
    }
    .rsvp-btn {
        background: white;
        border: 2px solid var(--amber);
        color: var(--amber);
    }
    .rsvp-btn:hover {
        background: var(--amber);
        color: white;
        transform: translateY(-2px);
    }

    #myrooms-section {
        margin-top: 0;
    }
    .myrooms-empty {
        text-align: center;
        padding: 60px 20px;
        background: var(--white);
        border-radius: 20px;
        border: 1px solid var(--border);
    }
    .myrooms-empty h3 {
        font-family: "Playfair Display", serif;
        font-size: 24px;
        margin-bottom: 12px;
        color: var(--ink);
    }
    .myrooms-empty p {
        color: var(--muted);
        margin-bottom: 20px;
    }

  
    #no-result {
        display: none;
        text-align: center;
        padding: 60px 20px;
    }
    #no-result h3 {
        font-family: "Playfair Display", serif;
        color: var(--teal);
        font-size: 22px;
    }

    
    #joinPopup {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(26,18,8,.7);
        z-index: 1000;
        backdrop-filter: blur(4px);
        align-items: center;
        justify-content: center;
    }
    #joinPopup.open {
        display: flex;
    }
    .popup-box {
        background: var(--white);
        width: 100%;
        max-width: 420px;
        margin: 20px;
        padding: 32px;
        border-radius: 20px;
        border-top: 4px solid var(--amber);
        box-shadow: 0 24px 60px rgba(0,0,0,.3);
    }
    .popup-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }
    .popup-header h3 {
        color: var(--teal);
        font-size: 20px;
        font-family: "Playfair Display", serif;
        margin: 0;
    }
    .popup-close {
        background: none;
        border: none;
        font-size: 28px;
        cursor: pointer;
        color: var(--muted);
        padding: 0;
        line-height: 1;
    }
    .popup-close:hover {
        color: var(--ink);
    }
    #popupBook {
        color: var(--muted);
        margin-bottom: 20px;
    }
    .input-group {
        margin-bottom: 14px;
    }
    .input-group input {
        width: 100%;
        padding: 12px 16px;
        border: 1.5px solid var(--border);
        border-radius: 50px;
        font-size: 14px;
        outline: none;
        background: var(--sand);
        font-family: "DM Sans", sans-serif;
    }
    .input-group input:focus {
        border-color: var(--teal);
        background: white;
    }
    .input-group input.error {
        border-color: #e53e3e;
    }
    .input-group small {
        display: none;
        color: #e53e3e;
        font-size: 12px;
        margin-top: 5px;
        padding-left: 12px;
    }
    .popup-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }
    .popup-actions button {
        flex: 1;
        padding: 12px;
        border-radius: 50px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        font-family: "DM Sans", sans-serif;
    }
    #confirmJoin {
        background: var(--teal);
        color: white;
        border: none;
    }
    #confirmJoin:hover {
        background: var(--teal-dark);
    }
    #cancelJoin {
        background: var(--amber-light);
        color: var(--muted);
        border: none;
    }
    #cancelJoin:hover {
        background: var(--border);
    }

    .empty-state {
        color: var(--muted);
        padding: 40px 20px;
        text-align: center;
        background: var(--white);
        border-radius: 16px;
    }

  
    @media (max-width: 1200px) { 
        .stats-container { grid-template-columns: repeat(2,1fr); } 
    }
    @media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }
        .stats-container {
            grid-template-columns: repeat(2,1fr);
        }
        .rooms-container {
            grid-template-columns: 1fr;
        }
    }
    @media (max-width: 600px) {
        .page-body { padding: 20px 4vw; }
        .stats-container { gap: 12px; }
        .stat-card { padding: 15px; }
        .stat-number { font-size: 24px; }
        .nav-tab { padding: 8px 18px; font-size: 12px; }
    }
    @media (max-width: 400px) { 
        .stats-container { grid-template-columns: 1fr; } 
    }
</style>
{% endblock %}

{% block body %}
<div class="page-wrapper">

    <div class="page-header">
        <div class="page-header-text">
            <h1>Reading Rooms</h1>
            <p>Read together with the community</p>
        </div>
        <a href="{{ path('app_room_create') }}" class="create-room-btn">+ Create Room</a>
    </div>

    <div class="page-body">

      
        <div class="stats-container">
            <div class="stat-card live">
                <div class="stat-info">
                    <div class="stat-title">LIVE NOW</div>
                    <div class="stat-number">{{ lives|length }}</div>
                </div>
                <div class="stat-icon">
                    <img src="https://i.pinimg.com/736x/cf/ac/d5/cfacd53f5bc159e0c2c01b69f3de1771.jpg" alt="Live"/>
                </div>
            </div>
            <div class="stat-card scheduled">
                <div class="stat-info">
                    <div class="stat-title">SCHEDULED</div>
                    <div class="stat-number">{{ scheduled|length }}</div>
                </div>
                <div class="stat-icon">
                    <img src="https://i.pinimg.com/1200x/ea/fb/8b/eafb8b1c4c949f9343740e590c5652c8.jpg" alt="Scheduled"/>
                </div>
            </div>
            <div class="stat-card myrooms">
                <div class="stat-info">
                    <div class="stat-title">MY ROOMS</div>
                    <div class="stat-number">{{ myRooms is defined ? myRooms|length : 0 }}</div>
                </div>
                <div class="stat-icon">
                    <img src="https://i.pinimg.com/1200x/c3/41/6e/c3416efade9f62b399498e657113ddf7.jpg" alt="My Rooms"/>
                </div>
            </div>
            <div class="stat-card totalrooms">
                <div class="stat-info">
                    <div class="stat-title">TOTAL ROOMS</div>
                    <div class="stat-number">{{ lives|length + scheduled|length }}</div>
                </div>
                <div class="stat-icon">
                    <img src="https://i.pinimg.com/736x/7a/9c/51/7a9c5126a655aa763c4f7e830c03a2f5.jpg" alt="Total"/>
                </div>
            </div>
        </div>

      
        <div class="search-area">
            <input type="text" class="search-bar" id="search_bar" placeholder="🔍 Search by book title or author..."/>
        </div>

       
        <div class="nav-tabs">
            <a href="#" class="nav-tab active" data-tab="discover">Discover</a>
            <a href="#" class="nav-tab" data-tab="live">Live now</a>
            <a href="#" class="nav-tab" data-tab="scheduled">Scheduled</a>
            <a href="#" class="nav-tab" data-tab="myrooms">My rooms</a>
        </div>
        <hr class="separator"/>

        <div id="live-section" class="tab-section">
            <div class="section-label">LIVE SESSIONS</div>
            <div class="rooms-container">
                {% if lives is empty %}
                    <p class="empty-state">No live sessions at the moment.</p>
                {% else %}
                    {% for room in lives %}
                    <div class="room-card" data-title="{{ room.titre|lower }}" data-author="{{ room.auteur|lower }}">
                        <div class="room-image">
                            <img src="{{ room.image starts with 'http' ? room.image : asset('uploads/rooms/' ~ room.image) }}"
                                 alt="{{ room.titre }}"
                                 onerror="this.src='{{ asset('uploads/rooms/default-book.jpg') }}'"/>
                            <span class="badge live">LIVE</span>
                            <span class="participants">0/{{ room.maxParticipants }}</span>
                        </div>
                        <div class="room-content">
                            <h3>{{ room.titre }}</h3>
                            <p class="room-author">{{ room.auteur }}</p>
                            <div class="progress-container">
                                <div class="progress-bar-bg">
                                    <div class="progress-bar-fill" style="width:0%"></div>
                                </div>
                                <p class="progress-text">Page 0 of {{ room.totalPages }}</p>
                            </div>
                            {% if room.tagsArray is defined and room.tagsArray %}
                            <div class="tags">
                                {% for tag in room.tagsArray %}
                                    <span class="tag">{{ tag|trim }}</span>
                                {% endfor %}
                            </div>
                            {% endif %}
                            <button class="room-action-btn join-btn" onclick="openJoinPopup('{{ room.titre|escape('js') }}')">Join Now</button>
                        </div>
                    </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>

       
        <div id="scheduled-section" class="tab-section" style="display: none;">
            <div class="section-label">UPCOMING SESSIONS</div>
            <div class="rooms-container">
                {% if scheduled is empty %}
                    <p class="empty-state">No upcoming sessions.</p>
                {% else %}
                    {% for room in scheduled %}
                    <div class="room-card" data-title="{{ room.titre|lower }}" data-author="{{ room.auteur|lower }}">
                        <div class="room-image">
                            <img src="{{ room.image starts with 'http' ? room.image : asset('uploads/rooms/' ~ room.image) }}"
                                 alt="{{ room.titre }}"
                                 onerror="this.src='{{ asset('uploads/rooms/default-book.jpg') }}'"/>
                            <span class="badge scheduled">Scheduled</span>
                            <span class="participants">0/{{ room.maxParticipants }}</span>
                        </div>
                        <div class="room-content">
                            <h3>{{ room.titre }}</h3>
                            <p class="room-author">{{ room.auteur }}</p>
                            <div class="progress-container">
                                <div class="progress-bar-bg">
                                    <div class="progress-bar-fill" style="width:0%"></div>
                                </div>
                                <p class="progress-text">Page 0 of {{ room.totalPages }}</p>
                            </div>
                            {% if room.tagsArray is defined and room.tagsArray %}
                            <div class="tags">
                                {% for tag in room.tagsArray %}
                                    <span class="tag">{{ tag|trim }}</span>
                                {% endfor %}
                            </div>
                            {% endif %}
                            <button class="room-action-btn rsvp-btn" onclick="openRsvpPopup('{{ room.titre|escape('js') }}')">RSVP</button>
                        </div>
                    </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>

        
        <div id="myrooms-section" class="tab-section" style="display: none;">
            {% if myRooms is defined and myRooms|length > 0 %}
                <div class="rooms-container">
                    {% for room in myRooms %}
                    <div class="room-card" data-title="{{ room.titre|lower }}" data-author="{{ room.auteur|lower }}">
                        <div class="room-image">
                            <img src="{{ room.image starts with 'http' ? room.image : asset('uploads/rooms/' ~ room.image) }}"
                                 alt="{{ room.titre }}"
                                 onerror="this.src='{{ asset('uploads/rooms/default-book.jpg') }}'"/>
                            <span class="badge {{ room.type }}">{{ room.type == 'live' ? 'LIVE' : 'Scheduled' }}</span>
                            <span class="participants">0/{{ room.maxParticipants }}</span>
                        </div>
                        <div class="room-content">
                            <h3>{{ room.titre }}</h3>
                            <p class="room-author">{{ room.auteur }}</p>
                            <div class="progress-container">
                                <div class="progress-bar-bg">
                                    <div class="progress-bar-fill" style="width:0%"></div>
                                </div>
                                <p class="progress-text">Page 0 of {{ room.totalPages }}</p>
                            </div>
                            {% if room.tagsArray is defined and room.tagsArray %}
                            <div class="tags">
                                {% for tag in room.tagsArray %}
                                    <span class="tag">{{ tag|trim }}</span>
                                {% endfor %}
                            </div>
                            {% endif %}
                            <button class="room-action-btn join-btn" onclick="openJoinPopup('{{ room.titre|escape('js') }}')">Manage</button>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="myrooms-empty">
                    <h3>No rooms yet</h3>
                    <p>Create your own room or join an existing one to start reading with the community.</p>
                    <a href="{{ path('app_room_create') }}" class="create-room-btn">+ Create Room</a>
                </div>
            {% endif %}
        </div>

      
        <div id="no-result">
            <h3>No rooms found</h3>
            <p>No reading room matches "<span id="search-query"></span>"</p>
        </div>

    </div>
</div>


<div id="joinPopup">
    <div class="popup-box">
        <div class="popup-header">
            <h3>Join Room</h3>
            <button class="popup-close" onclick="closePopup()">✕</button>
        </div>
        <p id="popupBook"></p>
        <div class="input-group">
            <input type="text" id="popupName" placeholder="Your name"/>
            <small id="errorName">Please enter your name</small>
        </div>
        <div class="input-group">
            <input type="email" id="popupEmail" placeholder="Your email"/>
            <small id="errorEmail">Please enter a valid email</small>
        </div>
        <div class="popup-actions">
            <button id="confirmJoin" onclick="confirmJoin()">Join</button>
            <button id="cancelJoin" onclick="closePopup()">Cancel</button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/ui-controls.js') }}"></script>
<script>

const tabs = document.querySelectorAll('.nav-tab');
const sections = {
    discover: ['live-section', 'scheduled-section'],
    live: ['live-section'],
    scheduled: ['scheduled-section'],
    myrooms: ['myrooms-section']
};

function showTab(tabId) {
    
    document.querySelectorAll('.tab-section').forEach(section => {
        section.style.display = 'none';
    });
    
    
    const sectionsToShow = sections[tabId] || sections.discover;
    sectionsToShow.forEach(sectionId => {
        const section = document.getElementById(sectionId);
        if (section) section.style.display = 'block';
    });
    
    
    tabs.forEach(tab => {
        if (tab.dataset.tab === tabId) {
            tab.classList.add('active');
        } else {
            tab.classList.remove('active');
        }
    });
}

tabs.forEach(tab => {
    tab.addEventListener('click', function(e) {
        e.preventDefault();
        const tabId = this.dataset.tab;
        showTab(tabId);
    });
});


const searchBar = document.getElementById('search_bar');
const searchQuerySpan = document.getElementById('search-query');
const noResultDiv = document.getElementById('no-result');

function filterRooms() {
    const query = searchBar.value.trim().toLowerCase();
    const cards = document.querySelectorAll('.room-card');
    let visibleCount = 0;
    
    cards.forEach(card => {
        const title = card.dataset.title || '';
        const author = card.dataset.author || '';
        const isVisible = query === '' || title.includes(query) || author.includes(query);
        card.style.display = isVisible ? 'flex' : 'none';
        if (isVisible) visibleCount++;
    });
    
    if (noResultDiv && searchQuerySpan) {
        const shouldShowNoResult = visibleCount === 0 && query !== '';
        noResultDiv.style.display = shouldShowNoResult ? 'block' : 'none';
        if (shouldShowNoResult) {
            searchQuerySpan.textContent = query;
        }
    }
}

if (searchBar) {
    searchBar.addEventListener('input', filterRooms);
}


let currentAction = 'join';

function openJoinPopup(bookTitle) {
    currentAction = 'join';
    document.getElementById('popupBook').textContent = 'Book: ' + bookTitle;
    const confirmBtn = document.getElementById('confirmJoin');
    if (confirmBtn) confirmBtn.textContent = 'Join';
    document.getElementById('joinPopup').classList.add('open');
}

function openRsvpPopup(bookTitle) {
    currentAction = 'rsvp';
    document.getElementById('popupBook').textContent = 'Book: ' + bookTitle;
    const confirmBtn = document.getElementById('confirmJoin');
    if (confirmBtn) confirmBtn.textContent = 'RSVP';
    document.getElementById('joinPopup').classList.add('open');
}

function closePopup() {
    document.getElementById('joinPopup').classList.remove('open');
    const nameInput = document.getElementById('popupName');
    const emailInput = document.getElementById('popupEmail');
    if (nameInput) nameInput.value = '';
    if (emailInput) emailInput.value = '';
    if (nameInput) nameInput.classList.remove('error');
    if (emailInput) emailInput.classList.remove('error');
    const errorName = document.getElementById('errorName');
    const errorEmail = document.getElementById('errorEmail');
    if (errorName) errorName.style.display = 'none';
    if (errorEmail) errorEmail.style.display = 'none';
}

function confirmJoin() {
    const nameInput = document.getElementById('popupName');
    const emailInput = document.getElementById('popupEmail');
    const errorName = document.getElementById('errorName');
    const errorEmail = document.getElementById('errorEmail');
    let isValid = true;

    if (!nameInput.value.trim()) {
        nameInput.classList.add('error');
        if (errorName) errorName.style.display = 'block';
        isValid = false;
    } else {
        nameInput.classList.remove('error');
        if (errorName) errorName.style.display = 'none';
    }
    
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(emailInput.value.trim())) {
        emailInput.classList.add('error');
        if (errorEmail) errorEmail.style.display = 'block';
        isValid = false;
    } else {
        emailInput.classList.remove('error');
        if (errorEmail) errorEmail.style.display = 'none';
    }
    
    if (isValid) {
        console.log(currentAction + ' confirmed for:', nameInput.value, emailInput.value);
        
        closePopup();
        alert('Successfully ' + (currentAction === 'join' ? 'joined' : 'RSVPed to') + ' the room!');
    }
}


document.getElementById('joinPopup').addEventListener('click', function(e) {
    if (e.target === this) closePopup();
});

showTab('discover');
</script>
