{% extends 'base.html.twig' %}

{% block title %}Create a Reading Room - KITABI{% endblock %}

{% block stylesheets %}
<style>
    .page-wrapper { 
        min-height: calc(100vh - var(--nav-h)); 
        background: var(--sand);
    }
    
    .page-header {
        background: linear-gradient(105deg, rgba(26,18,8,.97) 0%, rgba(14,107,94,.9) 60%, rgba(200,134,10,.4) 100%);
        padding: 36px 5vw 30px;
    }
    .page-header h1 {
        font-family: "Playfair Display", serif;
        font-size: 32px;
        font-weight: 900;
        color: #fff;
        margin: 0;
    }
    .page-header p {
        color: rgba(255,253,248,.6);
        font-size: 14px;
        margin: 6px 0 0;
    }
    
    .form-wrapper {
        padding: 36px 5vw;
        background: var(--sand);
    }
    
    .card {
        background: var(--white);
        border-radius: 20px;
        padding: 36px;
        box-shadow: 0 4px 24px rgba(26,18,8,.08);
        border: 1px solid var(--border);
        max-width: 780px;
        margin: 0 auto;
    }
    .card-title {
        font-family: "Playfair Display", serif;
        font-size: 22px;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 4px;
    }
    .card-subtitle {
        font-size: 14px;
        color: var(--muted);
        margin-bottom: 28px;
    }
    
    .field {
        margin-bottom: 20px;
    }
    .field label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 7px;
    }
    .field input, .field select, .field textarea {
        width: 100%;
        padding: 11px 16px;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        font-size: 14px;
        font-family: "DM Sans", sans-serif;
        background: var(--sand);
        outline: none;
    }
    .field input:focus, .field select:focus, .field textarea:focus {
        border-color: var(--teal);
        box-shadow: 0 0 0 3px rgba(14,107,94,.1);
        background: #fff;
    }
    
    .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }
    
    .upload-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 20px;
        border: 1.5px dashed var(--border);
        border-radius: 10px;
        cursor: pointer;
        font-size: 14px;
        color: var(--muted);
        background: #fffdf9;
        width: 100%;
    }
    .upload-btn:hover {
        border-color: var(--amber);
        color: var(--amber);
    }
    
    .type-toggle {
        display: flex;
        gap: 10px;
        margin-bottom: 10px;
    }
    .type-opt {
        flex: 1;
        padding: 10px 20px;
        border: 1.5px solid var(--border);
        border-radius: 50px;
        background: var(--white);
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all .25s;
    }
    .type-opt:hover {
        border-color: var(--teal);
        color: var(--teal);
    }
    .type-opt.selected {
        background: var(--teal);
        border-color: var(--teal);
        color: #fff;
    }
    
    .tags-selector {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 8px;
    }
    .tag-opt {
        padding: 6px 16px;
        border: 1.5px solid var(--border);
        border-radius: 50px;
        background: var(--white);
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s;
    }
    .tag-opt:hover {
        border-color: var(--amber);
        color: var(--amber);
    }
    .tag-opt.selected {
        background: var(--amber-light);
        border-color: var(--amber);
        color: var(--rust);
    }
    
    .card-footer {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
    }
    .btn-cancel {
        padding: 12px 28px;
        border: 1.5px solid var(--border);
        border-radius: 50px;
        background: var(--white);
        color: var(--muted);
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
    }
    .btn-cancel:hover {
        border-color: var(--muted);
        color: var(--ink);
    }
    .btn-create {
        padding: 12px 32px;
        border: none;
        border-radius: 50px;
        background: var(--teal);
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all .3s;
    }
    .btn-create:hover {
        background: var(--teal-dark);
        transform: translateY(-2px);
    }
    
    @media (max-width: 560px) {
        .field-row {
            grid-template-columns: 1fr;
            gap: 0;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="page-wrapper">
    <div class="page-header">
        <h1>Create a Reading Room</h1>
        <p>Set up a new space to read and discuss with the community</p>
    </div>

    <div class="form-wrapper">
        <div class="card">
            <h2 class="card-title">Room Details</h2>
            <p class="card-subtitle">Fill in the information below to create your reading room.</p>

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
                
                <div class="field">
                    <label>Book cover</label>
                    <label class="upload-btn" for="room_imageFile">
                        <span class="material-icons">upload_file</span>
                        <span id="upload-label">Choose a cover image</span>
                    </label>
                    {{ form_widget(form.imageFile, {'attr': {'style': 'display:none', 'onchange': 'document.getElementById("upload-label").innerText = this.files[0]?.name || "Choose a cover image"'}})}}
                </div>

                <div class="field">
                    {{ form_label(form.titre) }}
                    {{ form_widget(form.titre) }}
                </div>

                <div class="field-row">
                    <div class="field">
                        {{ form_label(form.auteur) }}
                        {{ form_widget(form.auteur) }}
                    </div>
                    <div class="field">
                        {{ form_label(form.totalPages) }}
                        {{ form_widget(form.totalPages) }}
                    </div>
                </div>

                <div class="field">
                    <label>Room type</label>
                    <div class="type-toggle">
                        <button type="button" class="type-opt selected" data-type="live">Live Session</button>
                        <button type="button" class="type-opt" data-type="scheduled">Scheduled</button>
                    </div>
                    {{ form_widget(form.type, {'attr': {'style': 'display:none'}})}}
                </div>

                <div class="field-row">
                    <div class="field">
                        {{ form_label(form.maxParticipants) }}
                        {{ form_widget(form.maxParticipants) }}
                    </div>
                    <div class="field">
                        {{ form_label(form.genre) }}
                        {{ form_widget(form.genre) }}
                    </div>
                </div>

                <div class="field">
                    <label>Tags</label>
                    <div class="tags-selector" id="tagsSelector">
                        {% set tags = ['Classic', 'Sci-Fi', 'Fantasy', 'Romance', 'Dystopian', 'Philosophy', 'Adventure', 'Drama', 'Fiction'] %}
                        {% for tag in tags %}
                            <button type="button" class="tag-opt" data-tag="{{ tag }}">{{ tag }}</button>
                        {% endfor %}
                    </div>
                    <div id="tagsInputs"></div>
                </div>

                <div class="field">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                </div>

                <div class="card-footer">
                    <a href="{{ path('app_rooms') }}" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn-create">Create Room</button>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
// Type toggle
document.querySelectorAll('.type-opt').forEach(function(btn) {
    btn.addEventListener('click', function() {
        var typeValue = this.dataset.type;
        var typeInput = document.querySelector('[name="room[type]"]');
        if (typeInput) typeInput.value = typeValue;
        
        document.querySelectorAll('.type-opt').forEach(function(b) {
            b.classList.remove('selected');
        });
        this.classList.add('selected');
    });
});

// Tags management
function rebuildTags() {
    var container = document.getElementById('tagsInputs');
    if (!container) return;
    container.innerHTML = '';
    document.querySelectorAll('.tag-opt.selected').forEach(function(tag) {
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'room_tags[]';
        input.value = tag.dataset.tag;
        container.appendChild(input);
    });
}

document.querySelectorAll('.tag-opt').forEach(function(tag) {
    tag.addEventListener('click', function() {
        this.classList.toggle('selected');
        rebuildTags();
    });
});

// Restore type on load
document.addEventListener('DOMContentLoaded', function() {
    var typeInput = document.querySelector('[name="room[type]"]');
    if (typeInput && typeInput.value) {
        var currentType = typeInput.value;
        document.querySelectorAll('.type-opt').forEach(function(btn) {
            if (btn.dataset.type === currentType) {
                btn.classList.add('selected');
            } else {
                btn.classList.remove('selected');
            }
        });
    }
});
</script>
{% endblock %}