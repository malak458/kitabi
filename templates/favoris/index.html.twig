{% extends 'base.html.twig' %}

{% block title %}Favorites - KITAB{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/marketPlace.css') }}" />
    <link rel="stylesheet" href="{{ asset('assets/css/favorites.css') }}?v=3.0" />
{% endblock %}

{% block body %}
<div class="page-wrapper">

  <div class="page-header">
    <h1 id="fav_title">My Favorites</h1>
    <h4 id="fav_subtitle">Your curated collection of beloved books</h4>
  </div>

  <div class="page-body">

    {# ===== STATS ===== #}
    <div class="stats">
      <div class="stat-card">
        <div>
          <p id="stat_total">Total</p>
          <h2>{{ totalFavorites }}</h2>
        </div>
        <img src="{{ asset('assets/images/fav.jpg') }}" alt="Total Favorites">
      </div>

      <div class="stat-card">
        <div>
          <p id="stat_value">Value</p>
          <h2>{{ totalValue|number_format(2, '.', '') }} dt</h2>
        </div>
        <img src="{{ asset('assets/images/2.jpg') }}" alt="Total Value">
      </div>

      <div class="stat-card">
        <div>
          <p id="stat_exchange">Exchange</p>
          <h2>{{ exchangeCount }}</h2>
        </div>
        <img src="{{ asset('assets/images/3.jpg') }}" alt="Exchange Count">
      </div>

      <div class="stat-card">
        <div>
          <p id="stat_genres">Genres</p>
          <h2>{{ genresCount }}</h2>
        </div>
        <img src="{{ asset('assets/images/4.jpg') }}" alt="Genres Count">
      </div>
    </div>

    {# ===== LISTE DES FAVORIS ===== #}
    <div class="favorites-container">

      {% if favBooks is defined and favBooks is not empty %}

        {% for fav in favBooks %}

          {% set book = fav.book %}
          {# On force la condition en minuscule pour correspondre parfaitement aux classes CSS du JS #}
          {% set bookCondition = book.condition|default('good')|lower %}

          <div class="favorite-card" id="book-{{ book.id }}">

            <div class="image-container">

              <img
                src="{% if book.image starts with 'http' %}{{ book.image }}{% else %}{{ asset('uploads/books/' ~ book.image) }}{% endif %}"
                alt="{{ book.titre }}"
              />

              {# Badge de condition #}
              <div class="condition {{ bookCondition }}">
                {{ bookCondition|capitalize }}
              </div>

              {# Bouton cœur rond #}
              <button
                class="heart-btn active"
                data-url="{{ path('app_book_favorite', { id: book.id }) }}"
                data-page-favoris="true"
                aria-label="Retirer des favoris">
                <span class="heart-icon">♥</span>
              </button>

              {% if book.forExchange %}
                <div class="exchange">Exchange</div>
              {% endif %}

            </div>

            <div class="card-body">

              <div class="book-main">
                <div class="book-left">
                  <h3>{{ book.titre }}</h3>
                  <p>{{ book.auteur|default('Unknown Author') }}</p>
                </div>
                <div class="book-right">
                  <div class="price">{{ book.prix }} dt</div>
                </div>
              </div>

              <div class="user-type">
                <div class="user">
                  <img src="{{ asset('images/user1.jpg') }}" alt="Owner" onerror="this.src='https://t3.ftcdn.net/jpg/02/99/04/20/360_F_299042079_vGBD7wIlSeNl7vOevWHiL93G4koMM967.jpg';">
                  {# CORRECTION ICI : Remplacement de 'Anonyme' par 'Anonymous' pour correspondre au système de détection JS #}
                  <span>{{ book.user ? book.user.username : 'Anonymous' }}</span>
                </div>
                <span class="genre">{{ book.genre|default('General') }}</span>
              </div>

              <div class="card-buttons">
                <a href="{{ path('app_book_show', { id: book.id }) }}" class="details">
                  <i class="bi bi-book"></i> Details
                </a>
                <a href="#" class="chat">
                  <i class="bi bi-chat-left"></i> Chat
                </a>
              </div>

            </div>
          </div>

        {% endfor %}

      {% else %}

        <div class="empty-favorites-box">
          <div class="empty-icon">
            <i class="bi bi-heartbreak"></i>
          </div>
          <h3 id="empty_fav_title">Your list is empty</h3>
          <p id="empty_fav_text">You haven't added any books to your favorites yet.</p>
          <a href="{{ path('app_marketplace') }}" class="explore-btn" id="empty_fav_btn">
            <span class="material-icons">local_mall</span>
            Explore Marketplace
          </a>
        </div>

      {% endif %}

    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/favorites-toggle.js') }}"></script>
    <script src="{{ asset('js/ui-controls.js') }}"></script>
    <script src="{{ asset('assets/js/fullscreen.js') }}"></script>
    <script src="{{ asset('assets/js/mode.js') }}"></script>
    <script src="{{ asset('assets/js/traduction.js') }}?v={{ random() }}"></script>
    
    {# ===== SCRIPT DE SÉCURITÉ POUR FORCER LA TRADUCTION IMMÉDIATE ===== #}
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        if (typeof window.setLang === "function") {
          const currentLang = localStorage.getItem("kitabi_lang") || "fr";
          window.setLang(currentLang);
        }
      });
    </script>
{% endblock %}