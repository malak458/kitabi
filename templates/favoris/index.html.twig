<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Favorites - KITAB</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Sans:wght@300;400;500;600&family=Amiri:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="icon" href="{{ asset('favicon (1).ico') }}" type="image/x-icon" />
    <link rel="stylesheet" href="{{ asset('assets/css/marketPlace.css') }}" />
    <link rel="stylesheet" href="{{ asset('assets/css/favorites.css') }}" />
  </head>

  <body>

    <nav id="mainNav">
      <a href="{{ path('app_marketplace') }}" class="logo">
        KITAB<span class="text_arb">كتاب</span>
      </a>

      <ul class="nav-links">
        <li>
          <a href="{{ path('app_marketplace') }}">
            <span class="material-icons">local_mall</span> Marketplace
          </a>
        </li>
        <li>
          <a href="{{ path('app_favoris') }}" class="active">
            <span class="material-icons">favorite</span> Favorites
          </a>
        </li>
      </ul>

      <div class="nav-right">
        {% if app.user %}
          <span class="nav-username">
            <span class="material-icons">account_circle</span>
            {{ app.user.username }}
          </span>
        {% endif %}
        <a href="{{ path('app_logout') }}">
          <span class="material-icons">logout</span> Log out
        </a>
      </div>
    </nav>

    <div class="page-wrapper">

      <div class="page-header">
        <h1>My Favorites</h1>
        <h4>Your curated collection of beloved books</h4>
      </div>

      <div class="page-body">

        {# ===== STATS ===== #}
        <div class="stats">
          <div class="stat-card">
            <div>
              <p>Total</p>
              <h2>{{ totalFavorites }}</h2>
            </div>
            <img src="{{ asset('images/fav.jpg') }}" alt="Total Favorites">
          </div>

          <div class="stat-card">
            <div>
              <p>Value</p>
              <h2>{{ totalValue|number_format(2, '.', '') }} dt</h2>
            </div>
            <img src="{{ asset('images/2.jpg') }}" alt="Total Value">
          </div>

          <div class="stat-card">
            <div>
              <p>Exchange</p>
              <h2>{{ exchangeCount }}</h2>
            </div>
            <img src="{{ asset('images/3.jpg') }}" alt="Exchange Count">
          </div>

          <div class="stat-card">
            <div>
              <p>Genres</p>
              <h2>{{ genresCount }}</h2>
            </div>
            <img src="{{ asset('images/4.jpg') }}" alt="Genres Count">
          </div>
        </div>

        {# ===== LISTE DES FAVORIS ===== #}
        <div class="favorites-container">

          {% if favBooks is not empty %}

            {% for fav in favBooks %}

              {% set book = fav.book %}
              {% set bookCondition = book.condition|default('good') %}

              <div class="favorite-card" id="book-{{ book.id }}">

                <div class="image-container">

                  <img
                    src="{% if book.image starts with 'http' %}{{ book.image }}{% else %}{{ asset('uploads/' ~ book.image) }}{% endif %}"
                    alt="{{ book.titre }}"
                  />

                  <div class="condition {{ bookCondition }}">
                    {{ bookCondition|capitalize }}
                  </div>

                  <button
                    class="heart-btn active"
                    data-url="{{ path('app_book_favorite', { id: book.id }) }}"
                    data-page-favoris="true"
                    aria-label="Retirer des favoris">
                    ♥
                  </button>

                  {% if book.forExchange %}
                    <div class="exchange">Exchange</div>
                  {% endif %}

                </div>

                <div class="card-body">

                  <div class="book-main">
                    <div class="book-left">
                      <h3>{{ book.titre }}</h3>
                      <p>{{ book.auteur|default('Unknown Author') }}</p>
                    </div>
                    <div class="book-right">
                      <div class="price">{{ book.prix }} dt</div>
                    </div>
                  </div>

                  <div class="user-type">
                    <div class="user">
                      <img src="{{ asset('images/user1.jpg') }}" alt="Owner">
                      <span>{{ book.user.username }}</span>
                    </div>
                    <span class="genre">{{ book.genre|default('General') }}</span>
                  </div>

                  <div class="card-buttons">
                    <a href="{{ path('app_book_details', { id: book.id }) }}" class="details">
                      <i class="bi bi-book"></i> Details
                    </a>
                    <a href="#" class="chat">
                      <i class="bi bi-chat-left"></i> Chat
                    </a>
                  </div>

                </div>
              </div>

            {% endfor %}

          {% else %}

            <div class="empty-favorites-box">
              <div class="empty-icon">
                <i class="bi bi-heartbreak"></i>
              </div>
              <h3>Your list is empty</h3>
              <p>You haven't added any books to your favorites yet.</p>
              <a href="{{ path('app_marketplace') }}" class="explore-btn">
                <span class="material-icons">local_mall</span>
                Explore Marketplace
              </a>
            </div>

          {% endif %}

        </div>
      </div>
    </div>

    <script src="{{ asset('assets/js/favorite-toggle.js') }}"></script>
  </body>
</html>