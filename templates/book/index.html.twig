<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>KITAB — Marketplace</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <style>
        body { background-color: #fcfbf7; font-family: 'DM Sans', sans-serif; color: #4a3e3d; }
        .hero { padding: 60px 0; text-align: center; }
        .hero h1 { font-family: 'Playfair Display', serif; color: #5c4033; }
        
        .book-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 30px; padding: 20px; }
        
        .book-card { background: #fff; border-radius: 15px; overflow: hidden; transition: 0.3s; border: 1px solid #efeae5; }
        .book-card:hover { transform: translateY(-10px); box-shadow: 0 20px 30px rgba(92, 64, 51, 0.15); }
        
        .book-image { height: 250px; object-fit: cover; width: 100%; }
        .card-content { padding: 20px; }
        .titre { font-family: 'Playfair Display', serif; font-size: 1.4rem; color: #5c4033; }
        .price { color: #2d5a27; font-weight: bold; font-size: 1.2rem; }
        .badge-exchange { background: #e8f5e9; color: #2d5a27; padding: 5px 10px; border-radius: 5px; font-size: 0.8rem; }
        .btn-details { border: 1px solid #5c4033; color: #5c4033; width: 100%; border-radius: 8px; transition: 0.3s; }
        .btn-details:hover { background: #5c4033; color: #fff; }
    </style>
</head>
<body>

<div class="container">
    <div class="hero">
        <h1>Découvrez nos Trésors Littéraires</h1>
    </div>

    <div class="book-grid">
        {% for book in books %}
            <div class="book-card">
                <img src="{{ asset('uploads/' ~ (book.image ?? 'default.jpg')) }}" class="book-image" alt="{{ book.titre }}">
                <div class="card-content">
                    <h3 class="titre">{{ book.titre }}</h3>
                    <p class="text-muted">Par {{ book.auteur }}</p>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="price">{{ book.prix }} DT</span>
                        {% if book.forExchange %}
                            <span class="badge-exchange">Échange possible</span>
                        {% endif %}
                    </div>
                    <a href="{{ path('app_book_details', {'id': book.id}) }}" class="btn btn-details">Voir les détails</a>
                </div>
            </div>
        {% else %}
            <p>Aucun livre disponible pour le moment.</p>
        {% endfor %}
    </div>
</div>

</body>
</html>