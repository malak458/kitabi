<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Kitabi - Lecture communautaire{% endblock %}</title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📚</text></svg>">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=DM+Sans:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --ink: #1a1208;
            --amber: #c8860a;
            --amber-mid: #e8a82a;
            --amber-light: #f9efd0;
            --rust: #8b3a1a;
            --teal: #0e6b5e;
            --teal-dark: #0a5046;
            --teal-light: #d6f0ec;
            --sand: #f5f0e8;
            --white: #fffdf8;
            --border: #e2d9c8;
            --muted: #7a6e5f;
            --nav-h: 68px;
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
        }

        html, body { width: 100%; overflow-x: hidden; }
        body { font-family: "DM Sans", sans-serif; background: var(--sand); color: var(--ink); min-height: 100vh; }

        /* ===== NAV ===== */
        nav#mainNav {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 200;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 5vw;
            height: var(--nav-h);
            background: rgba(26,18,8,0.97);
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 20px rgba(0,0,0,0.3);
        }
        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            font-weight: 900;
            color: var(--amber-mid);
            text-decoration: none;
        }
        .logo .text_arb {
            font-family: 'Amiri', serif;
            direction: rtl;
            font-size: 20px;
            margin-left: 4px;
            color: var(--rust);
        }
        .nav-links {
            display: flex; gap: 4px; list-style: none; align-items: center;
        }
        .nav-links a {
            display: flex; align-items: center; gap: 6px;
            text-decoration: none; font-size: 13px;
            color: rgba(255,253,248,.65);
            padding: 6px 12px; border-radius: 8px; transition: all .2s;
            white-space: nowrap;
        }
        .nav-links a:hover { color: var(--amber-mid); background: rgba(255,255,255,.06); }
        .nav-links a.active { color: var(--amber-mid); background: rgba(200,134,10,.15); }
        .nav-links .material-icons { font-size: 16px; }
        .nav-right { display: flex; align-items: center; gap: 16px; }
        .nav-right a {
            display: flex; align-items: center; gap: 6px;
            text-decoration: none; font-size: 13px;
            color: rgba(255,253,248,.65);
            padding: 6px 12px; border-radius: 8px; transition: all .2s;
        }
        .nav-right a:hover { color: var(--amber-mid); background: rgba(255,255,255,.06); }
        .lang-switcher-nav { display: flex; gap: 4px; margin-left: 16px; }
        .lang-btn {
            background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2);
            border-radius: 6px; color: rgba(255,253,248,.65);
            font-size: 11px; font-weight: 700; letter-spacing: .8px;
            padding: 4px 9px; cursor: pointer; transition: all .25s;
            font-family: "DM Sans", sans-serif;
        }
        .lang-btn:hover { background: rgba(255,255,255,.18); color: #fff; }
        .lang-btn.lang-active { background: var(--amber); border-color: var(--amber); color: #fff; }

        /* Flash messages */
        .flash-container {
            position: fixed; top: 80px; left: 50%;
            transform: translateX(-50%);
            z-index: 9999; display: flex; flex-direction: column; gap: 8px; align-items: center;
        }
        .flash-msg {
            padding: 14px 28px; border-radius: 50px;
            font-size: 14px; font-weight: 600;
            box-shadow: 0 6px 20px rgba(0,0,0,.2);
            animation: slideDown .4s ease;
        }
        .flash-success { background: var(--teal); color: white; }
        .flash-error   { background: #dc2626; color: white; }
        @keyframes slideDown {
            from { opacity:0; transform: translateY(-20px); }
            to   { opacity:1; transform: translateY(0); }
        }

        @media (max-width: 900px) { .nav-links { display: none; } }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>

<nav id="mainNav">
    <a href="{{ path('app_rooms') }}" class="logo">
        KITAB<span class="text_arb">كتاب</span>
    </a>

    <ul class="nav-links">
        <li><a href="{{ path('app_marketplace') }}"><span class="material-icons">local_mall</span> Marketplace</a></li>
        <li><a href="#"><span class="material-icons">chat_bubble</span> Messages</a></li>
        <li><a href="#"><span class="material-icons">swap_horiz</span> Exchanges</a></li>
        <li><a href="#"><span class="material-icons">favorite</span> Favorites</a></li>
        <li><a href="{{ path('app_rooms') }}" class="{{ app.request.attributes.get('_route') starts with 'app_room' ? 'active' : '' }}">
            <span class="material-icons">import_contacts</span> Reading Rooms
        </a></li>
    </ul>

    <div class="nav-right">
        {% if app.user %}
            <a href="/profile" id="nav_profile">
                <span class="material-icons">account_circle</span>
                {{ app.user.prenom ?? 'Profile' }}
            </a>
            <a href="{{ path('app_logout') }}" id="nav_logout">
                <span class="material-icons">logout</span> Logout
            </a>
        {% else %}
            <a href="{{ path('app_login') }}" id="nav_login">
                <span class="material-icons">login</span> Sign In
            </a>
            <a href="{{ path('app_register') }}" id="nav_register">
                <span class="material-icons">person_add</span> Sign Up
            </a>
        {% endif %}

        <div class="lang-switcher-nav">
            <button class="lang-btn lang-active" data-lang="en">EN</button>
            <button class="lang-btn" data-lang="fr">FR</button>
            <button class="lang-btn" data-lang="ar">AR</button>
        </div>
    </div>
</nav>

{% if app.flashes %}
<div class="flash-container">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-msg flash-{{ type }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}
</div>
{% endif %}

<main>
    {% block body %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
// Language switcher
document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('lang-active'));
        this.classList.add('lang-active');
    });
});
// Auto-hide flash messages
setTimeout(() => {
    document.querySelectorAll('.flash-msg').forEach(el => {
        el.style.transition = 'opacity .5s';
        el.style.opacity = '0';
        setTimeout(() => el.remove(), 500);
    });
}, 3500);
</script>

{% block javascripts %}{% endblock %}
</body>
</html>
