<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Kitabi - Plateforme de lecture communautaire">

    <title>{% block title %}Kitabi - Lecture communautaire{% endblock %}</title>

    {# Favicon #}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📚</text></svg>">

    {# Bootstrap CSS #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    {# Google Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=DM+Sans:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    {# CSS Global #}
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">

    {# Variables CSS globales #}
    <style>
        :root {
            --ink: #1a1208;
            --amber: #c8860a;
            --amber-mid: #e8a82a;
            --amber-light: #f9efd0;
            --rust: #8b3a1a;
            --teal: #0e6b5e;
            --teal-dark: #0a5046;
            --teal-light: #d6f0ec;
            --sand: #f5f0e8;
            --white: #fffdf8;
            --border: #e2d9c8;
            --muted: #7a6e5f;
            --nav-h: 68px;
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>

<nav id="mainNav">
    <a href="#" class="logo">
        KITAB<span class="text_arb">كتاب</span>
    </a>

    <ul class="nav-links">
        <li><a href="#"><span class="material-icons">local_mall</span> Marketplace</a></li>
        <li><a href="#"><span class="material-icons">chat_bubble</span> Messages</a></li>
        <li><a href="#"><span class="material-icons">swap_horiz</span> Exchanges</a></li>
        <li><a href="#"><span class="material-icons">favorite</span> Favorites</a></li>
        <li><a href="#" class="active"><span class="material-icons">import_contacts</span> Reading Rooms</a></li>
    </ul>

    <div class="nav-right">
        {% if app.user %}
            <a href="#" id="nav_profile">
                <span class="material-icons">account_circle</span>
                {{ app.user.prenom ?: 'Profile' }}
            </a>
            <a href="#" id="nav_logout">
                <span class="material-icons">logout</span> Logout
            </a>
        {% else %}
            <a href="#" id="nav_profile">
                <span class="material-icons">login</span> Sign In
            </a>
            <a href="#" id="nav_logout">
                <span class="material-icons">person_add</span> Sign Up
            </a>
        {% endif %}

        <div class="lang-switcher-nav">
            <button class="lang-btn" data-lang="en">EN</button>
            <button class="lang-btn" data-lang="fr">FR</button>
            <button class="lang-btn" data-lang="ar">AR</button>
        </div>
    </div>
</nav>

<main>
    {% block body %}{% endblock %}
</main>

{# Scripts Bootstrap #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{# Scripts principaux #}
<script src="{{ asset('js/translations.js') }}"></script>
<script src="{{ asset('js/ui-controls.js') }}"></script>

{% block javascripts %}{% endblock %}

</body>
</html>
