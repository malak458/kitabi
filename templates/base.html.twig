<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Kitabi{% endblock %}</title>
        
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220%22 0%22 128 128%22><text y=%221.2em%22 font-size=%2296%22>📚</text></svg>">
        
        {# Zone pour inclure les feuilles de style globales ou spécifiques #}
        {% block stylesheets %}
            {# Exemple avec Bootstrap via CDN si vous l'utilisez #}
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
            <link rel="stylesheet" href="{{ asset('css/app.css') }}">
        {% endblock %}
    </head>
    
    <body>
        {# 1. Barre de navigation globale #}
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
                <div class="container-fluid">
                    <a class="navbar-brand" href="#">Kitabi</a>
                    <div class="collapse navbar-collapse">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_rooms') }}">Salons</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        {# 2. Contenu dynamique injecté par vos autres vues (ex: room/index.html.twig) #}
        <main class="container my-4">
            {% block body %}{% endblock %}
        </main>

        {# 3. Pied de page global #}
        <footer class="bg-light text-center py-3 mt-auto">
            <div class="container">
                <span class="text-muted">&copy; {{ 'now'|date('Y') }} Kitabi - Tous droits réservés.</span>
            </div>
        </footer>

        {# Zone pour inclure vos scripts JavaScript #}
        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script src="{{ asset('js/app.js') }}"></script>
        {% endblock %}
    </body>
</html>