<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Kitabi{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📚</text></svg>">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=DM+Sans:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/banner.css') }}">

    <style>
        :root {
            --ink: #1a1208;
            --amber: #c8860a;
            --amber-mid: #e8a82a;
            --amber-light: #f9efd0;
            --rust: #8b3a1a;
            --teal: #0e6b5e;
            --teal-dark: #0a5046;
            --sand: #f5f0e8;
            --white: #fffdf8;
            --border: #e2d9c8;
            --muted: #7a6e5f;
            --nav-h: 68px;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: "DM Sans", sans-serif;
            background: var(--sand);
            color: var(--ink);
            margin: 0;
            padding: 0;
        }
        nav#mainNav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 200;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 5vw;
            height: var(--nav-h);
            background: rgba(26, 18, 8, 0.97);
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
        }
        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            font-weight: 900;
            color: var(--amber-mid);
            text-decoration: none;
        }
        .logo .text_arb {
            font-family: 'Amiri', serif;
            color: #8b3a1a;
        }
        .nav-links {
            display: flex;
            gap: 6px;
            list-style: none;
            align-items: center;
            margin: 0;
            padding: 0;
        }
        .nav-links li {
            list-style: none;
        }
        .nav-links a {
            display: flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            font-size: 13px;
            color: rgba(255, 255, 255, 0.7);
            padding: 6px 12px;
            border-radius: 8px;
            transition: 0.2s;
        }
        .nav-links a:hover {
            color: var(--amber-mid);
            background: rgba(255, 255, 255, 0.08);
        }
        .nav-links a.active {
            color: var(--amber-mid);
            background: rgba(200, 134, 10, 0.15);
        }
        .material-icons {
            font-size: 16px;
        }
        .nav-right {
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .nav-right a {
            display: flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            font-size: 13px;
            color: rgba(255, 255, 255, 0.7);
            padding: 6px 12px;
            border-radius: 8px;
            transition: 0.2s;
        }
        .nav-right a:hover {
            color: var(--amber-mid);
            background: rgba(255, 255, 255, 0.08);
        }
        .lang-switcher-nav {
            display: flex;
            gap: 4px;
        }
        .lang-switcher-nav button {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 11px;
            cursor: pointer;
        }
        .lang-switcher-nav button:hover {
            background: var(--amber);
        }
        .lang-active {
            background: var(--amber) !important;
        }
        main {
            padding-top: var(--nav-h);
        }
        @media(max-width: 900px) {
            .nav-links {
                display: none;
            }
        }

        /* Flash messages */
        .flash-container {
            position: fixed;
            top: 80px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1000;
            width: auto;
            max-width: 90%;
        }
        .flash-msg {
            padding: 12px 24px;
            margin-bottom: 8px;
            border-radius: 8px;
            color: white;
            font-weight: 500;
        }
        .flash-success { background: var(--teal); }
        .flash-error { background: #dc2626; }
        .flash-warning { background: var(--amber); }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>
    <nav id="mainNav">
        <a href="{{ path('app_marketplace') }}" class="logo">
            KITAB<span class="text_arb">كتاب</span>
        </a>
        <ul class="nav-links">
            <li><a href="{{ path('app_marketplace') }}" id="nav_marketplace"><span class="material-icons">local_mall</span>Marketplace</a></li>
            <li><a href="#" id="nav_messages"><span class="material-icons">chat_bubble</span>Messages</a></li>
            <li><a href="{{ path('exchange_page') }}" id="nav_exchanges"><span class="material-icons">swap_horiz</span>Exchanges</a></li>
            <li><a href="{{ path('app_favoris') }}" id="nav_favorites"><span class="material-icons">favorite</span>Favorites</a></li>
            <li><a href="{{ path('app_rooms') }}" id="nav_reading_rooms" class="active"><span class="material-icons">import_contacts</span>Reading Rooms</a></li>
        </ul>
        <div class="nav-right">
            {% if app.user %}
                <a href="{{ path('app_profile') }}" id="nav_profile"><span class="material-icons">account_circle</span>{{ app.user.prenom ?? 'Profile' }}</a>
                <a href="{{ path('app_logout') }}" id="nav_logout"><span class="material-icons">logout</span>Logout</a>
            {% else %}
                <a href="{{ path('app_login') }}"><span class="material-icons">login</span>Sign In</a>
                <a href="{{ path('app_register') }}"><span class="material-icons">person_add</span>Sign Up</a>
            {% endif %}
            <div class="lang-switcher-nav">
                <button class="lang-btn" id="btn-ar">AR</button>
                <button class="lang-btn" id="btn-fr">FR</button>
                <button class="lang-btn" id="btn-en">EN</button>
            </div>
        </div>
    </nav>

    {% for type, messages in app.flashes %}
        <div class="flash-container">
            {% for message in messages %}
                <div class="flash-msg flash-{{ type }}">{{ message }}</div>
            {% endfor %}
        </div>
    {% endfor %}

    <main>
        {% block body %}{% endblock %}
        {% block footer %}{% endblock %}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ asset('assets/js/traduction.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
