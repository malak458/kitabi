<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<title>
			{% block title %}Kitabi
			{% endblock %}
		</title>

		<link
		rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📚</text></svg>">

		<!-- CSS -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

		<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=DM+Sans:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="{{ asset('css/banner.css') }}">
		<style>:root
		{
			--ink: #1a1208;
			--amber: #c8860a;
			--amber-mid: #e8a82a;
			--sand: #f5f0e8;
			--white: #fffdf8;
			--nav-h: 68px;
		}

		* {
			box-sizing: border-box;
			margin: 0;
			padding: 0;
		}

		body {
			font-family: "DM Sans", sans-serif;
			background: var(--sand);
			color: var(--ink);
		}

		/* ===== NAVBAR ===== */
		nav#mainNav {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			z-index: 200;

			display: flex;
			align-items: center;
			justify-content: space-between;

			padding: 0 5vw;
			height: var(--nav-h);

			background: rgba(26, 18, 8, 0.97);
			backdrop-filter: blur(10px);
			box-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
		}

		.logo {
			font-family: 'Playfair Display', serif;
			font-size: 22px;
			font-weight: 900;
			color: var(--amber-mid);
			text-decoration: none;
		}

		.logo .text_arb {
			font-family: 'Amiri', serif;
			color: #8b3a1a;
		}

		.nav-links {
			display: flex;
			gap: 6px;
			list-style: none;
			align-items: center;
		}

		.nav-links a {
			display: flex;
			align-items: center;
			gap: 6px;
			text-decoration: none;
			font-size: 13px;
			color: rgba(255, 255, 255, 0.7);
			padding: 6px 12px;
			border-radius: 8px;
			transition: 0.2s;
		}

		.nav-links a:hover {
			color: var(--amber-mid);
			background: rgba(255, 255, 255, 0.08);
		}

		.nav-links a.active {
			color: var(--amber-mid);
			background: rgba(200, 134, 10, 0.15);
		}

		.material-icons {
			font-size: 16px;
		}

		.nav-right {
			display: flex;
			align-items: center;
			gap: 14px;
		}

		.lang-switcher-nav button {
			background: rgba(255, 255, 255, 0.1);
			border: 1px solid rgba(255, 255, 255, 0.2);
			color: white;
			padding: 4px 8px;
			border-radius: 6px;
			font-size: 11px;
			cursor: pointer;
		}

		.lang-active {
			background: var(--amber);
		}

		main {
			padding-top: calc(var(--nav-h) + 20px);
		}

		@media(max-width: 900px) {
			.nav-links {
				display: none;
			}
		}
	</style>

	{% block stylesheets %}{% endblock %}
</head>

<body>

	<nav
		id="mainNav">

		<!-- LOGO -->
		<a href="{{ path('app_marketplace') }}" class="logo">
			KITAB<span class="text_arb">كتاب</span>
		</a>

		<!-- LINKS -->
		<ul class="nav-links">
			<li>
				<a href="{{ path('app_marketplace') }}" class="{{ app.request.attributes.get('_route') starts with 'app_marketplace' ? 'active' : '' }}">
					<span class="material-icons">local_mall</span>
					Marketplace
				</a>
			</li>

			<li>
				<a href="#">
					<span class="material-icons">chat_bubble</span>
					Messages</a>
			</li>

			<li>
				<a href="#">
					<span class="material-icons">swap_horiz</span>
					Exchanges</a>
			</li>

			<li>
				<a href="#">
					<span class="material-icons">favorite</span>
					Favorites</a>
			</li>

			<li>
				<a href="{{ path('app_rooms') }}" class="{{ app.request.attributes.get('_route') starts with 'app_room' ? 'active' : '' }}">
					<span class="material-icons">import_contacts</span>
					Reading Rooms
				</a>
			</li>
		</ul>

		<!-- RIGHT -->
		<div class="nav-right">

			{% if app.user %}
				<a href="/profile">
					<span class="material-icons">account_circle</span>
					{{ app.user.prenom ?? 'Profile' }}
				</a>

				<a href="{{ path('app_logout') }}">
					<span class="material-icons">logout</span>
					Logout
				</a>
			{% else %}
				<a href="{{ path('app_login') }}">
					<span class="material-icons">login</span>
					Sign In
				</a>

				<a href="{{ path('app_register') }}">
					<span class="material-icons">person_add</span>
					Sign Up
				</a>
			{% endif %}

			<!-- LANG -->
			<div class="lang-switcher-nav">
				<button class="lang-btn lang-active">EN</button>
				<button class="lang-btn">FR</button>
				<button class="lang-btn">AR</button>
			</div>

		</div>
	</nav>

	<!-- FLASH -->
	{% for type, messages in app.flashes %}
		<div class="flash-container">
			{% for message in messages %}
				<div class="flash-msg flash-{{ type }}">
					{{ message }}
				</div>
			{% endfor %}
		</div>
	{% endfor %}

	<main>
		{% block body %}{% endblock %}
		{% block footer %}{% endblock %}
	</main>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

	<script>
		document.querySelectorAll('.lang-btn').forEach(btn => {
btn.addEventListener('click', () => {
document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('lang-active'));
btn.classList.add('lang-active');
});
});

setTimeout(() => {
document.querySelectorAll('.flash-msg').forEach(el => {
el.style.opacity = '0';
setTimeout(() => el.remove(), 500);
});
}, 3500);
	</script>

	{% block javascripts %}{% endblock %}

</body></html>
